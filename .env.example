# Copy to .env.local for local development and set the same variables in
# Vercel (Project → Settings → Environment Variables) for production.

# Formspree form endpoint. Server-only: it is read by /api/contact and never
# sent to the browser. Do not prefix it with NEXT_PUBLIC_.
FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Public URL of the site, used for canonical links, hreflang and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.janakshrestha25.com.np
